{
  "name": "kananeko",
  "version": "1.0.0",
  "private": true,
  "description": "A tiny Game Boy Color ROM where a cat teaches you kana, assembled entirely from TypeScript.",
  "license": "MIT",
  "author": "Carlos Villela",
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "contracts": "tsx scripts/contracts.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "typecheck": "tsc -b . src site test scripts site-tests",
    "test": "vitest run",
    "test:slow": "vitest run --reporter=verbose --slowTestThreshold=1000",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage && tsx scripts/check-coverage.ts",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "hooks:install": "prek install -t pre-commit -t commit-msg",
    "site": "tsx scripts/build-site.ts",
    "site:serve": "tsx scripts/serve-site.ts",
    "test:site": "npm run site && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@j178/prek": "^0.5.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "serverboy": "^0.0.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
